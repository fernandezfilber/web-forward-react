# ══════════════════════════════════════════════════════════════
# Forward Vision — Variables PRODUCCIÓN
# Copia como .env.prod y rellena los valores reales
# ══════════════════════════════════════════════════════════════

# ── Infraestructura (Docker) ──────────────────────────────────
DB_HOST=db
DB_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379

# ── MySQL ─────────────────────────────────────────────────────
DB_NAME=forwardvision_db
DB_USER=fv_user
DB_PASSWORD=CAMBIA_ESTO_password_segura_mysql
DB_ROOT_PASSWORD=CAMBIA_ESTO_root_password_muy_segura

# URL para Prisma: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=mysql://fv_user:CAMBIA_ESTO_password_segura_mysql@db:3306/forwardvision_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIA_ESTO_redis_password_segura

# ── JWT (genera con: openssl rand -hex 32) ────────────────────
JWT_SECRET=CAMBIA_ESTO_minimo_64_caracteres_openssl_rand_hex_32
JWT_REFRESH_SECRET=CAMBIA_ESTO_diferente_del_anterior_openssl_rand_hex_32
JWT_EXPIRES_IN=15m

# ── Google OAuth ──────────────────────────────────────────────
# Crear en: https://console.cloud.google.com → APIs → Credentials
# Callback URL: https://forwardvision.cloud/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx

# ── Session (para Passport OAuth, genera con: openssl rand -hex 16) ─
SESSION_SECRET=CAMBIA_ESTO_session_secret

# ── Email (Resend: https://resend.com → API Keys) ─────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@forwardvision.cloud

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Sentry (https://sentry.io → Create Project → Node.js) ────
SENTRY_DSN=https://xxxxxxxx@oxx.ingest.sentry.io/xxxxxxx

# ── App ────────────────────────────────────────────────────────
NODE_ENV=production
FRONTEND_URL=https://forwardvision.cloud
PORT=5000

# ── Frontend (se inyectan en build) ───────────────────────────
VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
