# ── Base de datos MySQL ───────────────────────────────────────
DB_NAME=forwardvision_db
DB_USER=fv_user
DB_PASSWORD=fv_secret
DB_ROOT_PASSWORD=root_secret

# Prisma URL (construida automáticamente en docker-compose)
DATABASE_URL=mysql://fv_user:fv_secret@localhost:3306/forwardvision_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── JWT ────────────────────────────────────────────────────────
# ⚠️  CAMBIA ESTOS VALORES EN PRODUCCIÓN (mínimo 64 caracteres)
JWT_SECRET=cambiar_esto_en_produccion_jwt_secret_muy_largo_abc123
JWT_REFRESH_SECRET=cambiar_esto_en_produccion_refresh_secret_muy_largo_xyz789
JWT_EXPIRES_IN=15m

# ── Cloudinary (obtener en cloudinary.com → Settings → API Keys) ──
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── App ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
NODE_ENV=development
PORT=5000

# ── Producción ─────────────────────────────────────────────────
# DOMAIN=forwardvision.cloud
